# Copy to backend/.env, chmod 600, and provision using manage.py credentials.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
COOKIE_SECURE=true
# For local HTTP development only: COOKIE_SECURE=false
# Default SQLite path is backend/instance/mdrt_certificates.db, independent of cwd.
